{
  "name": "esp32-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma migrate deploy && next build --webpack",
    "dev": "next dev",
    "lint": "eslint",
    "start": "next start",
    "test": "node scripts/test-auth-owner.mjs && node scripts/test-hardening.mjs && node scripts/test-battery-trend.mjs && node scripts/test-led-pattern.mjs && node scripts/test-weather-locations.mjs && node scripts/test-device-relink.mjs && node scripts/test-elf-loader.mjs && node scripts/test-pairing-display.mjs && node scripts/verify-projects.mjs && node scripts/test-projects.mjs",
    "typecheck": "tsc --noEmit",
    "auth:test": "node scripts/test-auth-owner.mjs",
    "battery:test": "node scripts/test-battery-trend.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "devices:test:relink": "node scripts/test-device-relink.mjs",
    "firmware:build": "node scripts/build-firmware.mjs",
    "firmware:test:led": "node scripts/test-led-pattern.mjs",
    "firmware:test:loader": "node scripts/test-elf-loader.mjs",
    "firmware:test:pairing": "node scripts/test-pairing-display.mjs",
    "postinstall": "prisma generate",
    "projects:build": "node scripts/build-projects.mjs",
    "projects:test": "node scripts/test-projects.mjs",
    "projects:verify": "node scripts/verify-projects.mjs",
    "security:test": "node scripts/test-hardening.mjs",
    "weather:test": "node scripts/test-weather-locations.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "esptool-js": "^0.6.1",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-serial-polyfill": "^1.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/w3c-web-usb": "^1.0.14",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.15.1"
}
