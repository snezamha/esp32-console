generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// An unlinked board waiting for someone to enter its code. One row per board (by MAC); a
/// restart replaces the previous pending row for that board.
model Pairing {
  mac       String    @id
  secret    String
  code      String
  board     String    @default("")
  firmware  String    @default("")
  expiresAt DateTime
  /// Set once the code is entered; the board picks up the device row on its next sync.
  deviceId  String?

  @@index([code])
}

model Device {
  id        String   @id @default(uuid())
  /// Stable hash of the verified Google email that added this device.
  owner     String
  token     String   @unique
  name      String   @default("")
  mac       String
  board     String   @default("")
  firmware  String   @default("")
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())
  ip        String   @default("")
  rssi      Int      @default(0)
  battery   Int      @default(-1)
  /// Filtered, calibrated battery-terminal voltage reported by the board.
  batteryMv Int      @default(0)
  charging  Boolean  @default(false)
  heap      Int      @default(0)
  uptime    Int      @default(0)
  /// Bumped on every console settings edit; the board applies settings when its rev is older.
  rev       Int      @default(0)
  /// Optimistic-concurrency guard: bumped on every write to this row.
  version   Int      @default(0)

  /// Last settings uploaded by the board.
  reported         Json
  /// Settings owned by each independently installed display project.
  projectSettings  Json    @default("{}")
  /// Console edits not yet confirmed by the board: { [key]: { value, rev } }.
  pending          Json    @default("{}")
  settingsReported Boolean @default(false)
  commands         Json    @default("[]")
  tests            Json    @default("{}")
  testsUpdatedAt   DateTime?
  /// One entry per minute, oldest first: { t, battery, batteryMv, rssi, heap }.
  samples          Json    @default("[]")
  ota              Json?
  /// [primary ssid, backup ssid].
  networks         Json    @default("[]")
  projectFiles     ProjectFile[]
  files            DeviceFile[]

  @@index([owner])
  @@index([mac])
}

/// Short-lived bytes of an SD card file manager operation, keyed by its command id: a browser
/// upload waiting for the board, or a folder listing / file the board sent for the browser.
model DeviceFile {
  id        String   @id
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  bytes     Bytes
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
}

/// A user-supplied project binary. Commands only retain this row's id, so retries do not copy
/// a base64 payload into the device JSON and normal device-list reads stay small.
model ProjectFile {
  id        String   @id @default(uuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name      String
  version   String
  bytes     Bytes
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
}
