# Copy to .env.local for local development. On Vercel, set these as project environment
# variables instead (Project Settings → Environment Variables) — see README.md.

# Neon Postgres — use the *pooled* connection string (hostname contains "-pooler").
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Random 32+ byte secret used to sign session cookies: `openssl rand -hex 32`
AUTH_SECRET=""

# Google OAuth client, from console.cloud.google.com → APIs & Services → Credentials.
# Authorized redirect URI: <your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
