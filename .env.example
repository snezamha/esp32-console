# Copy to .env.local for local development.
# On Vercel, set these under Project Settings → Environment Variables instead — see README.md
# ("Deploying"). Never commit .env.local (already gitignored).

# --- Database (Neon Postgres) ---------------------------------------------
# Use the *pooled* connection string (hostname contains "-pooler").
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js session -------------------------------------------------------
# Random 32+ byte secret used to sign session cookies: `openssl rand -hex 32`
AUTH_SECRET=""

# --- Google sign-in ----------------------------------------------------
# OAuth client from console.cloud.google.com → APIs & Services → Credentials
# (type: Web application). Authorized redirect URI: <your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Who may sign in -------------------------------------------------------
# Comma-separated list of full addresses and/or whole domains: "me@gmail.com,@mycompany.com".
# Leave it empty ONLY for a console nobody else can reach: without it every Google account can
# sign in, add its own boards and use the console. Project Builder (which compiles submitted C on
# the server) stays disabled until this is set.
AUTH_ALLOWED_EMAILS=""
