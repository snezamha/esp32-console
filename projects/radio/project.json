{
  "id": "radio",
  "name": "Internet radio",
  "version": "1.3.0",
  "abi": 5,
  "description": "Stream live MP3 radio: Persian, German and BBC stations, plus up to 3 of your own. Tap + or − for volume, hold to ramp volume, or double-tap to change stations.",
  "category": "Music",
  "icon": "radio",
  "accent": "#f97316",
  "minimumFirmware": "1.1.20",
  "capabilities": ["internet", "speaker"],
  "settings": [
    {
      "key": "station",
      "type": "select",
      "label": "Starting station",
      "default": "farda",
      "options": [
        { "value": "farda", "label": "Radio Farda · فارسی" },
        { "value": "navahang", "label": "Navahang · موسیقی ایرانی" },
        { "value": "bbc", "label": "BBC World Service" },
        { "value": "dlf", "label": "Deutschlandfunk · Deutsch" },
        { "value": "ndrinfo", "label": "NDR Info · Deutsch" },
        { "value": "1live", "label": "1LIVE · Deutsch" }
      ]
    },
    {
      "key": "custom1",
      "type": "text",
      "label": "Custom station 1 (stream URL)",
      "default": "",
      "maxLength": 120,
      "placeholder": "https://example.com/stream.mp3"
    },
    {
      "key": "custom2",
      "type": "text",
      "label": "Custom station 2 (stream URL)",
      "default": "",
      "maxLength": 120,
      "placeholder": "https://example.com/stream.mp3"
    },
    {
      "key": "custom3",
      "type": "text",
      "label": "Custom station 3 (stream URL)",
      "default": "",
      "maxLength": 120,
      "placeholder": "https://example.com/stream.mp3"
    }
  ]
}
