{
  "id": "radio",
  "name": "Internet radio",
  "version": "1.6.3",
  "abi": 6,
  "description": "Stream live MP3 radio with an eight-band visualizer driven by decoded audio: Persian, German and BBC stations, plus up to 3 of your own. Tap + or − for volume, hold to ramp volume, or double-tap to change stations.",
  "category": "Music",
  "icon": "radio",
  "accent": "#f97316",
  "minimumFirmware": "1.1.25",
  "capabilities": ["internet", "speaker"],
  "settings": [
    {
      "key": "station",
      "type": "select",
      "label": "Starting station",
      "default": "farda",
      "options": [
        { "value": "farda", "label": "Radio Farda · فارسی" },
        { "value": "navahang", "label": "Navahang · موسیقی ایرانی" },
        { "value": "bbc", "label": "BBC World Service" },
        { "value": "dlf", "label": "Deutschlandfunk · Deutsch" },
        { "value": "ndrinfo", "label": "NDR Info · Deutsch" },
        { "value": "1live", "label": "1LIVE · Deutsch" }
      ]
    },
    {
      "key": "custom1",
      "type": "text",
      "label": "Custom station 1 (stream URL)",
      "default": "",
      "maxLength": 120,
      "placeholder": "https://example.com/stream.mp3"
    },
    {
      "key": "custom1_name",
      "type": "text",
      "label": "Custom station 1 name",
      "default": "",
      "maxLength": 20,
      "asciiOnly": true,
      "placeholder": "English letters only"
    },
    {
      "key": "custom1_lang",
      "type": "select",
      "label": "Custom station 1 language",
      "default": "EN",
      "options": [
        { "value": "EN", "label": "English" },
        { "value": "FA", "label": "Persian" },
        { "value": "DE", "label": "German" },
        { "value": "AR", "label": "Arabic" },
        { "value": "TR", "label": "Turkish" },
        { "value": "FR", "label": "French" },
        { "value": "ES", "label": "Spanish" },
        { "value": "RU", "label": "Russian" },
        { "value": "XX", "label": "Other" }
      ]
    },
    {
